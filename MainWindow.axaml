
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="650"
        x:Class="MiPresentacion.MainWindow"
        Title="MiPresentacion"
        Width="500"
        Height="650">

    <StackPanel Margin="30" Spacing="15">

        <TextBlock Text="Mi primera aplicación gráfica"
                   FontSize="25"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20"/>

        <TextBlock Text="Nombre:"/>
        <TextBox x:Name="NombreTextBox"
                 Watermark="Escribe tu nombre"/>

        <TextBlock Text="Apellido:"/>
        <TextBox x:Name="ApellidoTextBox"
                 Watermark="Escribe tu apellido"/>

        <TextBlock Text="Edad:"/>
        <TextBox x:Name="EdadTextBox"
                 Watermark="Escribe tu edad"/>

        <StackPanel Orientation="Horizontal"
                    Spacing="10"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">

            <Button Content="Presentarme"
                    Click="Presentarme_Click"/>

            <Button Content="Limpiar"
                    Click="Limpiar_Click"/>

        </StackPanel>

        <Button Content="Cambiar saludo"
                Click="CambiarSaludo_Click"
                HorizontalAlignment="Center"/>

        <TextBlock Text="Aquí aparecerá tu presentación."
                   x:Name="ResultadoTextBlock"
                   FontSize="16"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"/>

    </StackPanel>

</Window>
